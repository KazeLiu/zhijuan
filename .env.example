# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，不要提交真实值。

# 管理员名单（JSON 数组字符串）。姓名经 NFC 规范化后与名单做全等比较。
# 默认值 ["管理员"]；多人时写多个元素，例如 ["张三","李四"]
NUXT_ADMIN_NAMES=["管理员"]

# 私有数据目录（数据库 + 上传资料）。相对路径以进程工作目录为基准，默认 data
# 生产环境建议指到构建目录之外，例如 D:/zhijuan-data
NUXT_DATA_DIR=data

# 会话有效期（天），默认 7
NUXT_SESSION_TTL_DAYS=7

# 会话 Cookie 名，默认 zj_session
NUXT_SESSION_COOKIE_NAME=zj_session

# 生产启动端口：node .output/server/index.mjs 会读取该变量（开发端口固定 4310，见 nuxt.config.ts）
PORT=4310

# 模型服务（Base URL / API Key / 模型 ID）不放在环境变量里：
# 按设计 §2.2 由管理端「模型设置」页写入数据库，API Key 只在服务端保存、读取接口仅返回 hasApiKey。
